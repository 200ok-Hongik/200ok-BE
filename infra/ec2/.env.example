# Copy to .env on the server only. Do not commit real secrets.
API_DOMAIN=api.example.com
APP_IMAGE=ssok-backend:local
SERVER_PORT=5000
SPRING_PROFILES_ACTIVE=production
JAVA_TOOL_OPTIONS=-XX:MaxRAMPercentage=65.0

DB_URL=jdbc:mysql://mysql:3306/app_db?serverTimezone=Asia/Seoul&characterEncoding=UTF-8
DB_USERNAME=app
DB_PASSWORD=replace-with-random-password
MYSQL_ROOT_PASSWORD=replace-with-another-random-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

RABBITMQ_ENABLED=true
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=ssok
RABBITMQ_PASSWORD=replace-with-random-password
RABBITMQ_VIRTUAL_HOST=/
RABBITMQ_SSL_ENABLED=false

AWS_REGION=ap-northeast-2
S3_ENABLED=true
S3_BUCKET=replace-with-private-bucket-name
S3_PUBLIC_BASE_URL=https://replace-with-cloudfront-domain
JWT_SECRET_KEY=replace-with-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=1209600000
KAKAO_REST_API_KEY=replace-me
KAKAO_REST_API_SECRET=replace-me
KAKAO_REDIRECT_URI=https://api.example.com/login/oauth2/code/kakao
FRONTEND_URL=https://ssok.store
AI_SERVER_URL=https://two00ok-ai.onrender.com
NOTIFICATION_TIME_ZONE=Asia/Seoul
NOTIFICATION_DISPOSAL_CRON=0 0 9 * * *
NOTIFICATION_PUSH_PROVIDER=fake
BACKUP_S3_URI=s3://replace-with-backup-bucket/ssok/mysql
